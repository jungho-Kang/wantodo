{
  "expo": {
    "name": "wantodo",
    "slug": "wantodo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wantodo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#18382e",
        "foregroundImage": "./assets/icon-adaptive-fg.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "package": "com.junghokang.wantodo"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-font",
      "expo-calendar",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#18382e",
          "image": "./assets/splash-screen.png",
          "resizeMode": "cover"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ba8922ba-ee9b-4146-9132-ca2223212383"
      }
    }
  }
}
